           COMPUTE H-REMAINING-BILLED =
               H-BILLED - H-PLAN-PAID
           IF H-PAY-CENTS > H-REMAINING-BILLED
        PERFORM SET-EXCEEDS-BILLED
        EXIT PARAGRAPH
           END-IF
           IF H-PAY-CENTS <= H-POLICY-DEDUCTIBLE
        MOVE H-PAY-CENTS TO H-DEDUCTIBLE-TAKE
           ELSE
        MOVE H-POLICY-DEDUCTIBLE TO H-DEDUCTIBLE-TAKE
           END-IF
           COMPUTE H-AFTER-DEDUCTIBLE =
               H-PAY-CENTS - H-DEDUCTIBLE-TAKE
           COMPUTE H-PATIENT-COINS =
               H-AFTER-DEDUCTIBLE * H-COINSURANCE-PCT / 100
           COMPUTE H-PLAN-SHARE =
               H-AFTER-DEDUCTIBLE - H-PATIENT-COINS
           COMPUTE H-STOP-REMAINING =
               H-STOP-LOSS - H-PLAN-PAID
           IF H-PLAN-SHARE > H-STOP-REMAINING
        PERFORM SET-EXCEEDS-STOP-LOSS
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-PATIENT-PORTION =
               H-DEDUCTIBLE-TAKE + H-PATIENT-COINS
           COMPUTE H-NEW-PATIENT =
               H-PATIENT-PAID + H-PATIENT-PORTION
           COMPUTE H-NEW-PLAN =
               H-PLAN-PAID + H-PLAN-SHARE
           COMPUTE H-NEW-DEDUCTIBLE =
               H-REMAINING-DEDUCTIBLE - H-DEDUCTIBLE-TAKE
           IF H-NEW-DEDUCTIBLE < 0
        MOVE 0 TO H-NEW-DEDUCTIBLE
           END-IF.
