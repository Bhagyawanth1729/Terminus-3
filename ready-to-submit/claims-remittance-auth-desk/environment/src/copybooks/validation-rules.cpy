       VALIDATE-OPEN-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-CLAIM-ID
           PERFORM VALIDATE-POLICY-ID
           PERFORM VALIDATE-BILLED-CENTS.
       
       VALIDATE-AUTHORIZE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-CLAIM-ID
           PERFORM VALIDATE-REVISION
           PERFORM VALIDATE-REMITTANCE-ID
           PERFORM VALIDATE-PAY-CENTS.
       
       VALIDATE-CLAWBACK-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-CLAIM-ID
           PERFORM VALIDATE-REVISION
           PERFORM VALIDATE-REMITTANCE-ID
           PERFORM VALIDATE-CLAW-CENTS.
       
       VALIDATE-CLOSE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-CLAIM-ID
           PERFORM VALIDATE-REVISION.
       
       VALIDATE-REQUEST-ID.
           MOVE H-REQUEST TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) > 24
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-CLAIM-ID.
           MOVE H-CLAIM TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-CLAIM)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-CLAIM)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-POLICY-ID.
           MOVE H-POLICY TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-POLICY)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-POLICY)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-REMITTANCE-ID.
           MOVE H-REMITTANCE TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-REMITTANCE)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-REMITTANCE)) > 24
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-GENERAL-ID.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        MOVE "N" TO WS-ALLOWED
        IF WS-CHAR >= "A" AND WS-CHAR <= "Z"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR >= "0" AND WS-CHAR <= "9"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR = "-"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-ALLOWED NOT = "Y"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
       
       VALIDATE-REVISION.
           MOVE WS-REVISION-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-REVISION-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-EXPECTED-REVISION =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-REVISION-TEXT))
           IF H-EXPECTED-REVISION < 1 OR H-EXPECTED-REVISION > 999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-BILLED-CENTS.
           MOVE WS-BILLED-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-BILLED-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-BILLED =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-BILLED-TEXT))
           IF H-BILLED < 1 OR H-BILLED > 999999999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-PAY-CENTS.
           MOVE WS-PAY-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-PAY-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-PAY-CENTS =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-PAY-TEXT))
           IF H-PAY-CENTS < 1 OR H-PAY-CENTS > 999999999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-CLAW-CENTS.
           MOVE WS-CLAW-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-CLAW-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-CLAW-CENTS =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-CLAW-TEXT))
           IF H-CLAW-CENTS < 1 OR H-CLAW-CENTS > 999999999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-UNSIGNED-TEXT.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        IF WS-CHAR < "0" OR WS-CHAR > "9"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
