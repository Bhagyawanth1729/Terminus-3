           EXEC SQL
        SET TRANSACTION ISOLATION LEVEL SERIALIZABLE
           END-EXEC
           IF SQLCODE NOT = 0
        SET SQL-FAILED TO TRUE
        EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO H-LOCK-KEY
           STRING "REQUEST:" FUNCTION TRIM(H-REQUEST)
             INTO H-LOCK-KEY
           END-STRING
           EXEC SQL
           SELECT COUNT(*) INTO :H-COUNT
             FROM pg_advisory_xact_lock(
                  hashtext(:H-LOCK-KEY))
           END-EXEC
           IF SQLCODE NOT = 0
        SET SQL-FAILED TO TRUE
        EXIT PARAGRAPH
           END-IF.
