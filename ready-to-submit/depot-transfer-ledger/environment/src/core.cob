>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. DEPOT-TRANSFER-LEDGER.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PARTS-FILE ASSIGN TO DYNAMIC WS-PARTS-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-PARTS.
    SELECT STOCK-FILE ASSIGN TO DYNAMIC WS-STOCK-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-STOCK.
    SELECT EVENTS-FILE ASSIGN TO DYNAMIC WS-EVENTS-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-EVENTS.
    SELECT CLOSING-FILE ASSIGN TO DYNAMIC WS-CLOSING-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-CLOSING.
    SELECT TRANSIT-FILE ASSIGN TO DYNAMIC WS-TRANSIT-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-TRANSIT.
    SELECT EXCEPTIONS-FILE ASSIGN TO DYNAMIC WS-EXCEPTIONS-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-EXCEPTIONS.
    SELECT SUMMARY-FILE ASSIGN TO DYNAMIC WS-SUMMARY-PATH
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS FS-SUMMARY.

DATA DIVISION.
FILE SECTION.
FD PARTS-FILE.
01 PARTS-RECORD PIC X(512).
FD STOCK-FILE.
01 STOCK-RECORD PIC X(512).
FD EVENTS-FILE.
01 EVENTS-RECORD PIC X(512).
FD CLOSING-FILE.
01 CLOSING-RECORD PIC X(512).
FD TRANSIT-FILE.
01 TRANSIT-RECORD PIC X(512).
FD EXCEPTIONS-FILE.
01 EXCEPTIONS-RECORD PIC X(512).
FD SUMMARY-FILE.
01 SUMMARY-RECORD PIC X(512).

WORKING-STORAGE SECTION.
COPY "rows.cpy".

01 WS-PARTS-PATH PIC X(256).
01 WS-STOCK-PATH PIC X(256).
01 WS-EVENTS-PATH PIC X(256).
01 WS-OUTPUT-PATH PIC X(256).
01 WS-CLOSING-PATH PIC X(320).
01 WS-TRANSIT-PATH PIC X(320).
01 WS-EXCEPTIONS-PATH PIC X(320).
01 WS-SUMMARY-PATH PIC X(320).
01 WS-ARG PIC X(256).
01 WS-ARGC PIC 9(4) COMP.
01 WS-RETURN-CODE PIC 9 VALUE 0.
01 WS-FATAL PIC X VALUE "N".
01 WS-EOF PIC X VALUE "N".
01 WS-VALID PIC X VALUE "Y".
01 WS-REASON PIC X(24).
01 WS-CHECK-TEXT PIC X(32).
01 WS-CHECK-LEN PIC 9(4) COMP.
01 WS-RECORD-LEN PIC 9(4) COMP.
01 WS-I PIC 9(4) COMP.
01 WS-J PIC 9(4) COMP.
01 WS-K PIC 9(4) COMP.
01 WS-IDX PIC 9(4) COMP.
01 WS-PART-IDX PIC 9(4) COMP.
01 WS-SOURCE-IDX PIC 9(4) COMP.
01 WS-DEST-IDX PIC 9(4) COMP.
01 WS-REF-IDX PIC 9(4) COMP.
01 WS-DISPATCH-IDX PIC 9(4) COMP.
01 WS-FOUND PIC X VALUE "N".
01 WS-SWAPPED PIC X VALUE "N".
01 WS-SORT-NEEDED PIC X VALUE "N".
01 WS-YEAR PIC 9(4) COMP.
01 WS-MONTH PIC 9(2) COMP.
01 WS-DAY PIC 9(2) COMP.
01 WS-MAX-DAY PIC 9(2) COMP.
01 WS-LEAP-REMAINDER PIC 9(4) COMP.
01 WS-COUNT PIC 9(9) COMP-3 VALUE 0.
01 WS-ACCEPTED-COUNT PIC 9(9) COMP-3 VALUE 0.
01 WS-DUPLICATE-COUNT PIC 9(9) COMP-3 VALUE 0.
01 WS-REJECTED-COUNT PIC 9(9) COMP-3 VALUE 0.
01 WS-TOTAL-CLOSING PIC 9(18) COMP-3 VALUE 0.
01 WS-TOTAL-TRANSIT PIC 9(18) COMP-3 VALUE 0.
01 WS-ONHAND-VALUE PIC 9(18) COMP-3 VALUE 0.
01 WS-TRANSIT-VALUE PIC 9(18) COMP-3 VALUE 0.
01 WS-PRODUCT PIC 9(18) COMP-3 VALUE 0.
01 WS-NUM-DISPLAY PIC Z(17)9.
01 WS-SUMMARY-LINE PIC X(128).
01 WS-EXCEPTION-LINE PIC X(64).
01 WS-BEST-ID PIC X(12).
01 WS-BEST-IDX PIC 9(4) COMP.
01 WS-STOCK-KEY-A PIC X(17).
01 WS-STOCK-KEY-B PIC X(17).
01 WS-TEMP-STOCK.
   05 WS-TS-DEPOT PIC X(6).
   05 WS-TS-PART PIC X(10).
   05 WS-TS-COND PIC X.
   05 WS-TS-QTY PIC 9(9) COMP-3.

01 FS-PARTS PIC XX.
01 FS-STOCK PIC XX.
01 FS-EVENTS PIC XX.
01 FS-CLOSING PIC XX.
01 FS-TRANSIT PIC XX.
01 FS-EXCEPTIONS PIC XX.
01 FS-SUMMARY PIC XX.

01 PART-TABLE.
   05 PART-COUNT PIC 9(4) COMP VALUE 0.
   05 PART-ENTRY OCCURS 200 TIMES.
      10 P-PART PIC X(10).
      10 P-COND PIC X.
      10 P-CENTS PIC 9(9) COMP-3.
      10 P-ACTIVE PIC X.

01 STOCK-TABLE.
   05 STOCK-COUNT PIC 9(4) COMP VALUE 0.
   05 STOCK-ENTRY OCCURS 400 TIMES.
      10 S-DEPOT PIC X(6).
      10 S-PART PIC X(10).
      10 S-COND PIC X.
      10 S-QTY PIC 9(9) COMP-3.

01 EVENT-TABLE.
   05 EVENT-COUNT PIC 9(4) COMP VALUE 0.
   05 EVENT-ENTRY OCCURS 500 TIMES.
      10 E-RAW PIC X(81).
      10 E-INPUT-ORDER PIC 9(4) COMP.
      10 E-ID PIC X(12).
      10 E-DATE PIC X(8).
      10 E-SEQ-TEXT PIC X(4).
      10 E-SEQ PIC 9(4) COMP.
      10 E-SEQ-VALID PIC X.
      10 E-TYPE PIC X.
      10 E-REF PIC X(12).
      10 E-TRANSFER PIC X(12).
      10 E-SOURCE PIC X(6).
      10 E-DEST PIC X(6).
      10 E-PART PIC X(10).
      10 E-COND PIC X.
      10 E-QTY-TEXT PIC X(9).
      10 E-QTY PIC 9(9) COMP-3.
      10 E-QTY-VALID PIC X.
      10 E-DATE-VALID PIC X.
      10 E-ACCEPTED PIC X.
      10 E-REJECTED PIC X.
      10 E-VOIDED PIC X.
      10 E-ORIGINAL PIC 9(9) COMP-3.
      10 E-OUTSTANDING PIC 9(9) COMP-3.
      10 E-ACTIVE-RECEIVED PIC 9(9) COMP-3.
      10 E-DISPATCH-INDEX PIC 9(4) COMP.

01 TEMP-EVENT.
   05 T-RAW PIC X(81).
   05 T-INPUT-ORDER PIC 9(4) COMP.
   05 T-ID PIC X(12).
   05 T-DATE PIC X(8).
   05 T-SEQ-TEXT PIC X(4).
   05 T-SEQ PIC 9(4) COMP.
   05 T-SEQ-VALID PIC X.
   05 T-TYPE PIC X.
   05 T-REF PIC X(12).
   05 T-TRANSFER PIC X(12).
   05 T-SOURCE PIC X(6).
   05 T-DEST PIC X(6).
   05 T-PART PIC X(10).
   05 T-COND PIC X.
   05 T-QTY-TEXT PIC X(9).
   05 T-QTY PIC 9(9) COMP-3.
   05 T-QTY-VALID PIC X.
   05 T-DATE-VALID PIC X.
   05 T-ACCEPTED PIC X.
   05 T-REJECTED PIC X.
   05 T-VOIDED PIC X.
   05 T-ORIGINAL PIC 9(9) COMP-3.
   05 T-OUTSTANDING PIC 9(9) COMP-3.
   05 T-ACTIVE-RECEIVED PIC 9(9) COMP-3.
   05 T-DISPATCH-INDEX PIC 9(4) COMP.

01 EXCEPTION-TABLE.
   05 EXCEPTION-COUNT PIC 9(4) COMP VALUE 0.
   05 EXCEPTION-ENTRY OCCURS 500 TIMES.
      10 X-ID PIC X(12).
      10 X-REASON PIC X(24).

PROCEDURE DIVISION.
MAIN.
    PERFORM PARSE-ARGUMENTS
    IF WS-FATAL = "Y"
        DISPLAY "invalid command line" UPON STDERR
        STOP RUN RETURNING 2
    END-IF
    PERFORM BUILD-OUTPUT-PATHS
    PERFORM LOAD-PARTS
    IF WS-FATAL = "Y" STOP RUN RETURNING 2 END-IF
    PERFORM LOAD-STOCK
    IF WS-FATAL = "Y" STOP RUN RETURNING 2 END-IF
    PERFORM LOAD-EVENTS
    IF WS-FATAL = "Y" STOP RUN RETURNING 2 END-IF
    PERFORM SORT-EVENTS
    PERFORM PROCESS-EVENTS
    PERFORM CALCULATE-SUMMARY
    IF WS-FATAL = "Y" STOP RUN RETURNING 2 END-IF
    PERFORM WRITE-REPORTS
    IF WS-FATAL = "Y" STOP RUN RETURNING 2 END-IF
    STOP RUN RETURNING 0.

PARSE-ARGUMENTS.
    ACCEPT WS-ARGC FROM ARGUMENT-NUMBER
    IF WS-ARGC NOT = 8
        MOVE "Y" TO WS-FATAL
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
        DISPLAY WS-I UPON ARGUMENT-NUMBER
        ACCEPT WS-ARG FROM ARGUMENT-VALUE
        EVALUATE WS-I
            WHEN 1 IF FUNCTION TRIM(WS-ARG) NOT = "--parts" MOVE "Y" TO WS-FATAL END-IF
            WHEN 2 MOVE WS-ARG TO WS-PARTS-PATH
            WHEN 3 IF FUNCTION TRIM(WS-ARG) NOT = "--stock" MOVE "Y" TO WS-FATAL END-IF
            WHEN 4 MOVE WS-ARG TO WS-STOCK-PATH
            WHEN 5 IF FUNCTION TRIM(WS-ARG) NOT = "--events" MOVE "Y" TO WS-FATAL END-IF
            WHEN 6 MOVE WS-ARG TO WS-EVENTS-PATH
            WHEN 7 IF FUNCTION TRIM(WS-ARG) NOT = "--output" MOVE "Y" TO WS-FATAL END-IF
            WHEN 8 MOVE WS-ARG TO WS-OUTPUT-PATH
        END-EVALUATE
    END-PERFORM.

BUILD-OUTPUT-PATHS.
    STRING FUNCTION TRIM(WS-OUTPUT-PATH) "/closing-stock.dat" DELIMITED BY SIZE INTO WS-CLOSING-PATH END-STRING
    STRING FUNCTION TRIM(WS-OUTPUT-PATH) "/open-transit.dat" DELIMITED BY SIZE INTO WS-TRANSIT-PATH END-STRING
    STRING FUNCTION TRIM(WS-OUTPUT-PATH) "/exceptions.dat" DELIMITED BY SIZE INTO WS-EXCEPTIONS-PATH END-STRING
    STRING FUNCTION TRIM(WS-OUTPUT-PATH) "/summary.dat" DELIMITED BY SIZE INTO WS-SUMMARY-PATH END-STRING.

CHECK-DIGITS.
    MOVE "Y" TO WS-VALID
    IF WS-CHECK-LEN = 0 MOVE "N" TO WS-VALID EXIT PARAGRAPH END-IF
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-CHECK-LEN
        IF WS-CHECK-TEXT(WS-K:1) < "0" OR WS-CHECK-TEXT(WS-K:1) > "9"
            MOVE "N" TO WS-VALID
        END-IF
    END-PERFORM.

VALIDATE-DATE.
    MOVE E-DATE(WS-IDX) TO WS-CHECK-TEXT
    MOVE 8 TO WS-CHECK-LEN
    PERFORM CHECK-DIGITS
    MOVE WS-VALID TO E-DATE-VALID(WS-IDX)
    IF WS-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    MOVE E-DATE(WS-IDX)(1:4) TO WS-YEAR
    MOVE E-DATE(WS-IDX)(5:2) TO WS-MONTH
    MOVE E-DATE(WS-IDX)(7:2) TO WS-DAY
    IF WS-YEAR = 0 OR WS-MONTH < 1 OR WS-MONTH > 12 OR WS-DAY < 1
        MOVE "N" TO E-DATE-VALID(WS-IDX)
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-MONTH
        WHEN 1 WHEN 3 WHEN 5 WHEN 7 WHEN 8 WHEN 10 WHEN 12 MOVE 31 TO WS-MAX-DAY
        WHEN 4 WHEN 6 WHEN 9 WHEN 11 MOVE 30 TO WS-MAX-DAY
        WHEN 2
            MOVE 28 TO WS-MAX-DAY
            DIVIDE WS-YEAR BY 4 GIVING WS-I REMAINDER WS-LEAP-REMAINDER
            IF WS-LEAP-REMAINDER = 0
                MOVE 29 TO WS-MAX-DAY
                DIVIDE WS-YEAR BY 100 GIVING WS-I REMAINDER WS-LEAP-REMAINDER
                IF WS-LEAP-REMAINDER = 0
                    MOVE 28 TO WS-MAX-DAY
                    DIVIDE WS-YEAR BY 400 GIVING WS-I REMAINDER WS-LEAP-REMAINDER
                    IF WS-LEAP-REMAINDER = 0 MOVE 29 TO WS-MAX-DAY END-IF
                END-IF
            END-IF
    END-EVALUATE
    IF WS-DAY > WS-MAX-DAY MOVE "N" TO E-DATE-VALID(WS-IDX) END-IF.

LOAD-PARTS.
    OPEN INPUT PARTS-FILE
    IF FS-PARTS NOT = "00" MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y" OR WS-FATAL = "Y"
        MOVE SPACES TO PARTS-RECORD
        READ PARTS-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-PART
        END-READ
    END-PERFORM
    CLOSE PARTS-FILE.

PARSE-PART.
    COMPUTE WS-RECORD-LEN = FUNCTION STORED-CHAR-LENGTH(PARTS-RECORD)
    IF WS-RECORD-LEN NOT = 21 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF PART-COUNT >= 200 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF FUNCTION TRIM(PARTS-RECORD(1:10)) = SPACES MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE PARTS-RECORD(12:9) TO WS-CHECK-TEXT
    MOVE 9 TO WS-CHECK-LEN
    PERFORM CHECK-DIGITS
    IF WS-VALID NOT = "Y" MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF PARTS-RECORD(21:1) NOT = "Y" AND PARTS-RECORD(21:1) NOT = "N"
        MOVE "Y" TO WS-FATAL EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PART-COUNT
        IF P-PART(WS-I) = PARTS-RECORD(1:10) AND P-COND(WS-I) = PARTS-RECORD(11:1)
            MOVE "Y" TO WS-FATAL
        END-IF
    END-PERFORM
    IF WS-FATAL = "Y" EXIT PARAGRAPH END-IF
    ADD 1 TO PART-COUNT
    MOVE PARTS-RECORD(1:10) TO P-PART(PART-COUNT)
    MOVE PARTS-RECORD(11:1) TO P-COND(PART-COUNT)
    MOVE PARTS-RECORD(12:9) TO P-CENTS(PART-COUNT)
    MOVE PARTS-RECORD(21:1) TO P-ACTIVE(PART-COUNT).

LOAD-STOCK.
    OPEN INPUT STOCK-FILE
    IF FS-STOCK NOT = "00" MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y" OR WS-FATAL = "Y"
        MOVE SPACES TO STOCK-RECORD
        READ STOCK-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-STOCK
        END-READ
    END-PERFORM
    CLOSE STOCK-FILE.

PARSE-STOCK.
    COMPUTE WS-RECORD-LEN = FUNCTION STORED-CHAR-LENGTH(STOCK-RECORD)
    IF WS-RECORD-LEN NOT = 26 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF STOCK-COUNT >= 400 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF FUNCTION TRIM(STOCK-RECORD(1:6)) = SPACES MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE STOCK-RECORD(18:9) TO WS-CHECK-TEXT
    MOVE 9 TO WS-CHECK-LEN
    PERFORM CHECK-DIGITS
    IF WS-VALID NOT = "Y" MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE 0 TO WS-PART-IDX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PART-COUNT
        IF P-PART(WS-I) = STOCK-RECORD(7:10) AND P-COND(WS-I) = STOCK-RECORD(17:1)
            MOVE WS-I TO WS-PART-IDX
        END-IF
    END-PERFORM
    IF WS-PART-IDX = 0 OR P-ACTIVE(WS-PART-IDX) NOT = "Y"
        MOVE "Y" TO WS-FATAL EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > STOCK-COUNT
        IF S-DEPOT(WS-I) = STOCK-RECORD(1:6) AND S-PART(WS-I) = STOCK-RECORD(7:10) AND S-COND(WS-I) = STOCK-RECORD(17:1)
            MOVE "Y" TO WS-FATAL
        END-IF
    END-PERFORM
    IF WS-FATAL = "Y" EXIT PARAGRAPH END-IF
    ADD 1 TO STOCK-COUNT
    MOVE STOCK-RECORD(1:6) TO S-DEPOT(STOCK-COUNT)
    MOVE STOCK-RECORD(7:10) TO S-PART(STOCK-COUNT)
    MOVE STOCK-RECORD(17:1) TO S-COND(STOCK-COUNT)
    MOVE STOCK-RECORD(18:9) TO S-QTY(STOCK-COUNT).

LOAD-EVENTS.
    OPEN INPUT EVENTS-FILE
    IF FS-EVENTS NOT = "00" MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y" OR WS-FATAL = "Y"
        MOVE SPACES TO EVENTS-RECORD
        READ EVENTS-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-EVENT
        END-READ
    END-PERFORM
    CLOSE EVENTS-FILE
    MOVE EVENT-COUNT TO WS-COUNT.

PARSE-EVENT.
    COMPUTE WS-RECORD-LEN = FUNCTION STORED-CHAR-LENGTH(EVENTS-RECORD)
    IF WS-RECORD-LEN NOT = 81 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    IF EVENT-COUNT >= 500 MOVE "Y" TO WS-FATAL EXIT PARAGRAPH END-IF
    ADD 1 TO EVENT-COUNT
    MOVE EVENT-COUNT TO WS-IDX E-INPUT-ORDER(EVENT-COUNT)
    MOVE EVENTS-RECORD(1:81) TO E-RAW(EVENT-COUNT)
    MOVE EVENTS-RECORD(1:12) TO E-ID(EVENT-COUNT)
    MOVE EVENTS-RECORD(13:8) TO E-DATE(EVENT-COUNT)
    MOVE EVENTS-RECORD(21:4) TO E-SEQ-TEXT(EVENT-COUNT)
    MOVE EVENTS-RECORD(25:1) TO E-TYPE(EVENT-COUNT)
    MOVE EVENTS-RECORD(26:12) TO E-REF(EVENT-COUNT)
    MOVE EVENTS-RECORD(38:12) TO E-TRANSFER(EVENT-COUNT)
    MOVE EVENTS-RECORD(50:6) TO E-SOURCE(EVENT-COUNT)
    MOVE EVENTS-RECORD(56:6) TO E-DEST(EVENT-COUNT)
    MOVE EVENTS-RECORD(62:10) TO E-PART(EVENT-COUNT)
    MOVE EVENTS-RECORD(72:1) TO E-COND(EVENT-COUNT)
    MOVE EVENTS-RECORD(73:9) TO E-QTY-TEXT(EVENT-COUNT)
    MOVE "N" TO E-ACCEPTED(EVENT-COUNT) E-REJECTED(EVENT-COUNT) E-VOIDED(EVENT-COUNT)
    MOVE 0 TO E-ORIGINAL(EVENT-COUNT) E-OUTSTANDING(EVENT-COUNT) E-ACTIVE-RECEIVED(EVENT-COUNT) E-DISPATCH-INDEX(EVENT-COUNT)
    MOVE E-SEQ-TEXT(EVENT-COUNT) TO WS-CHECK-TEXT
    MOVE 4 TO WS-CHECK-LEN
    PERFORM CHECK-DIGITS
    MOVE WS-VALID TO E-SEQ-VALID(EVENT-COUNT)
    IF WS-VALID = "Y" MOVE E-SEQ-TEXT(EVENT-COUNT) TO E-SEQ(EVENT-COUNT) ELSE MOVE 0 TO E-SEQ(EVENT-COUNT) END-IF
    MOVE E-QTY-TEXT(EVENT-COUNT) TO WS-CHECK-TEXT
    MOVE 9 TO WS-CHECK-LEN
    PERFORM CHECK-DIGITS
    MOVE WS-VALID TO E-QTY-VALID(EVENT-COUNT)
    IF WS-VALID = "Y" MOVE E-QTY-TEXT(EVENT-COUNT) TO E-QTY(EVENT-COUNT) ELSE MOVE 0 TO E-QTY(EVENT-COUNT) END-IF
    PERFORM VALIDATE-DATE.

COPY "a.c".

PROCESS-EVENTS.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > EVENT-COUNT
        MOVE SPACES TO WS-REASON
        PERFORM CHECK-DUPLICATE
        IF WS-REASON = SPACES AND E-REJECTED(WS-IDX) NOT = "D"
            PERFORM VALIDATE-COMMON
        END-IF
        IF WS-REASON = SPACES AND E-REJECTED(WS-IDX) NOT = "D"
            EVALUATE E-TYPE(WS-IDX)
                WHEN "D" PERFORM PROCESS-DISPATCH
                WHEN "R" PERFORM PROCESS-RECEIPT
                WHEN "V" PERFORM PROCESS-VOID
            END-EVALUATE
        END-IF
        IF WS-REASON NOT = SPACES
            PERFORM REJECT-CURRENT
        END-IF
    END-PERFORM.

COPY "b.c".

VALIDATE-COMMON.
    IF E-REJECTED(WS-IDX) = "D" EXIT PARAGRAPH END-IF
    IF E-DATE-VALID(WS-IDX) NOT = "Y" MOVE "BAD_DATE" TO WS-REASON EXIT PARAGRAPH END-IF
    IF E-SEQ-VALID(WS-IDX) NOT = "Y" MOVE "BAD_SEQUENCE" TO WS-REASON EXIT PARAGRAPH END-IF
    IF E-TYPE(WS-IDX) NOT = "D" AND E-TYPE(WS-IDX) NOT = "R" AND E-TYPE(WS-IDX) NOT = "V"
        MOVE "BAD_TYPE" TO WS-REASON
    END-IF.

FIND-PART.
    MOVE 0 TO WS-PART-IDX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PART-COUNT
        IF P-PART(WS-I) = E-PART(WS-IDX) AND P-COND(WS-I) = E-COND(WS-IDX)
            MOVE WS-I TO WS-PART-IDX
        END-IF
    END-PERFORM.

FIND-STOCKS.
    MOVE 0 TO WS-SOURCE-IDX WS-DEST-IDX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > STOCK-COUNT
        IF S-DEPOT(WS-I) = E-SOURCE(WS-IDX) AND S-PART(WS-I) = E-PART(WS-IDX) AND S-COND(WS-I) = E-COND(WS-IDX)
            MOVE WS-I TO WS-SOURCE-IDX
        END-IF
        IF S-DEPOT(WS-I) = E-DEST(WS-IDX) AND S-PART(WS-I) = E-PART(WS-IDX) AND S-COND(WS-I) = E-COND(WS-IDX)
            MOVE WS-I TO WS-DEST-IDX
        END-IF
    END-PERFORM.

FIND-ACCEPTED-REFERENCE.
    MOVE 0 TO WS-REF-IDX
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I >= WS-IDX OR WS-REF-IDX > 0
        IF E-ID(WS-I) = E-REF(WS-IDX) AND E-ACCEPTED(WS-I) = "Y"
            MOVE WS-I TO WS-REF-IDX
        END-IF
    END-PERFORM.

PROCESS-DISPATCH.
    IF FUNCTION TRIM(E-REF(WS-IDX)) NOT = SPACES OR E-TRANSFER(WS-IDX) NOT = E-ID(WS-IDX)
        MOVE "BAD_TRANSFER" TO WS-REASON EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(E-SOURCE(WS-IDX)) = SPACES OR FUNCTION TRIM(E-DEST(WS-IDX)) = SPACES OR E-SOURCE(WS-IDX) = E-DEST(WS-IDX)
        MOVE "BAD_ROUTE" TO WS-REASON EXIT PARAGRAPH
    END-IF
    PERFORM FIND-PART
    PERFORM FIND-STOCKS
    IF WS-PART-IDX = 0 OR WS-SOURCE-IDX = 0 OR WS-DEST-IDX = 0
        MOVE "UNKNOWN_STOCK" TO WS-REASON EXIT PARAGRAPH
    END-IF
    IF P-ACTIVE(WS-PART-IDX) NOT = "Y" MOVE "INACTIVE_PART" TO WS-REASON EXIT PARAGRAPH END-IF
    IF E-QTY-VALID(WS-IDX) NOT = "Y" OR E-QTY(WS-IDX) = 0
        MOVE "BAD_QUANTITY" TO WS-REASON EXIT PARAGRAPH
    END-IF
    IF S-QTY(WS-SOURCE-IDX) < E-QTY(WS-IDX)
        MOVE "INSUFFICIENT_STOCK" TO WS-REASON EXIT PARAGRAPH
    END-IF
    SUBTRACT E-QTY(WS-IDX) FROM S-QTY(WS-SOURCE-IDX)
    MOVE E-QTY(WS-IDX) TO E-ORIGINAL(WS-IDX) E-OUTSTANDING(WS-IDX)
    MOVE 0 TO E-ACTIVE-RECEIVED(WS-IDX)
    MOVE "Y" TO E-ACCEPTED(WS-IDX)
    ADD 1 TO WS-ACCEPTED-COUNT.

COPY "c.c".

COPY "d.c".

REJECT-CURRENT.
    IF E-REJECTED(WS-IDX) = "D" EXIT PARAGRAPH END-IF
    MOVE "Y" TO E-REJECTED(WS-IDX)
    ADD 1 TO WS-REJECTED-COUNT
    ADD 1 TO EXCEPTION-COUNT
    MOVE E-ID(WS-IDX) TO X-ID(EXCEPTION-COUNT)
    MOVE WS-REASON TO X-REASON(EXCEPTION-COUNT).

CALCULATE-SUMMARY.
    MOVE 0 TO WS-TOTAL-CLOSING WS-TOTAL-TRANSIT WS-ONHAND-VALUE WS-TRANSIT-VALUE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > STOCK-COUNT
        ADD S-QTY(WS-I) TO WS-TOTAL-CLOSING ON SIZE ERROR MOVE "Y" TO WS-FATAL END-ADD
        MOVE 0 TO WS-PART-IDX
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PART-COUNT
            IF P-PART(WS-J) = S-PART(WS-I) AND P-COND(WS-J) = S-COND(WS-I) MOVE WS-J TO WS-PART-IDX END-IF
        END-PERFORM
        COMPUTE WS-PRODUCT = S-QTY(WS-I) * P-CENTS(WS-PART-IDX) ON SIZE ERROR MOVE "Y" TO WS-FATAL END-COMPUTE
        ADD WS-PRODUCT TO WS-ONHAND-VALUE ON SIZE ERROR MOVE "Y" TO WS-FATAL END-ADD
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EVENT-COUNT
        IF E-TYPE(WS-I) = "D" AND E-ACCEPTED(WS-I) = "Y" AND E-VOIDED(WS-I) NOT = "Y" AND E-OUTSTANDING(WS-I) > 0
            ADD E-OUTSTANDING(WS-I) TO WS-TOTAL-TRANSIT ON SIZE ERROR MOVE "Y" TO WS-FATAL END-ADD
            MOVE 0 TO WS-PART-IDX
            PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PART-COUNT
                IF P-PART(WS-J) = E-PART(WS-I) AND P-COND(WS-J) = E-COND(WS-I) MOVE WS-J TO WS-PART-IDX END-IF
            END-PERFORM
            COMPUTE WS-PRODUCT = E-OUTSTANDING(WS-I) * P-CENTS(WS-PART-IDX) ON SIZE ERROR MOVE "Y" TO WS-FATAL END-COMPUTE
            ADD WS-PRODUCT TO WS-TRANSIT-VALUE ON SIZE ERROR MOVE "Y" TO WS-FATAL END-ADD
        END-IF
    END-PERFORM.

SORT-STOCKS.
    IF STOCK-COUNT < 2 EXIT PARAGRAPH END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I >= STOCK-COUNT
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > STOCK-COUNT - WS-I
            STRING S-DEPOT(WS-J) S-PART(WS-J) S-COND(WS-J) DELIMITED BY SIZE INTO WS-STOCK-KEY-A END-STRING
            STRING S-DEPOT(WS-J + 1) S-PART(WS-J + 1) S-COND(WS-J + 1) DELIMITED BY SIZE INTO WS-STOCK-KEY-B END-STRING
            IF WS-STOCK-KEY-A > WS-STOCK-KEY-B
                MOVE STOCK-ENTRY(WS-J) TO WS-TEMP-STOCK
                MOVE STOCK-ENTRY(WS-J + 1) TO STOCK-ENTRY(WS-J)
                MOVE WS-TEMP-STOCK TO STOCK-ENTRY(WS-J + 1)
            END-IF
        END-PERFORM
    END-PERFORM.

WRITE-REPORTS.
    OPEN OUTPUT CLOSING-FILE TRANSIT-FILE EXCEPTIONS-FILE SUMMARY-FILE
    IF FS-CLOSING NOT = "00" OR FS-TRANSIT NOT = "00" OR FS-EXCEPTIONS NOT = "00" OR FS-SUMMARY NOT = "00"
        MOVE "Y" TO WS-FATAL EXIT PARAGRAPH
    END-IF
    PERFORM SORT-STOCKS
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > STOCK-COUNT
        MOVE S-DEPOT(WS-I) TO SO-DEPOT
        MOVE S-PART(WS-I) TO SO-PART
        MOVE S-COND(WS-I) TO SO-COND
        MOVE S-QTY(WS-I) TO SO-QTY
        MOVE STOCK-OUTPUT-RECORD TO CLOSING-RECORD
        WRITE CLOSING-RECORD
    END-PERFORM
    PERFORM WRITE-TRANSIT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EXCEPTION-COUNT
        MOVE SPACES TO WS-EXCEPTION-LINE
        STRING FUNCTION TRIM(X-ID(WS-I) TRAILING) "|" FUNCTION TRIM(X-REASON(WS-I) TRAILING) DELIMITED BY SIZE INTO WS-EXCEPTION-LINE END-STRING
        MOVE FUNCTION TRIM(WS-EXCEPTION-LINE TRAILING) TO EXCEPTIONS-RECORD
        WRITE EXCEPTIONS-RECORD
    END-PERFORM
    MOVE WS-COUNT TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-INPUT
    MOVE WS-ACCEPTED-COUNT TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-ACCEPTED
    MOVE WS-DUPLICATE-COUNT TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-DUPLICATE
    MOVE WS-REJECTED-COUNT TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-REJECTED
    MOVE WS-TOTAL-CLOSING TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-CLOSING
    MOVE WS-TOTAL-TRANSIT TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-TRANSIT
    MOVE WS-ONHAND-VALUE TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-ONHAND
    MOVE WS-TRANSIT-VALUE TO WS-NUM-DISPLAY
    PERFORM WRITE-SUMMARY-TRANSIT-VALUE
    CLOSE CLOSING-FILE TRANSIT-FILE EXCEPTIONS-FILE SUMMARY-FILE.

WRITE-TRANSIT.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > EVENT-COUNT
        MOVE HIGH-VALUES TO WS-BEST-ID
        MOVE 0 TO WS-BEST-IDX
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EVENT-COUNT
            IF E-TYPE(WS-I) = "D" AND E-ACCEPTED(WS-I) = "Y" AND E-VOIDED(WS-I) NOT = "Y" AND E-OUTSTANDING(WS-I) > 0 AND E-ID(WS-I) < WS-BEST-ID AND E-REJECTED(WS-I) NOT = "W"
                MOVE E-ID(WS-I) TO WS-BEST-ID
                MOVE WS-I TO WS-BEST-IDX
            END-IF
        END-PERFORM
        IF WS-BEST-IDX = 0 EXIT PERFORM END-IF
        MOVE E-ID(WS-BEST-IDX) TO TO-ID
        MOVE E-SOURCE(WS-BEST-IDX) TO TO-SOURCE
        MOVE E-DEST(WS-BEST-IDX) TO TO-DEST
        MOVE E-PART(WS-BEST-IDX) TO TO-PART
        MOVE E-COND(WS-BEST-IDX) TO TO-COND
        MOVE E-ORIGINAL(WS-BEST-IDX) TO TO-ORIGINAL
        MOVE E-OUTSTANDING(WS-BEST-IDX) TO TO-OUTSTANDING
        MOVE TRANSIT-OUTPUT-RECORD TO TRANSIT-RECORD
        WRITE TRANSIT-RECORD
        MOVE "W" TO E-REJECTED(WS-BEST-IDX)
    END-PERFORM.

WRITE-SUMMARY-INPUT.
    PERFORM WRITE-SUMMARY-LINE-BASE.
WRITE-SUMMARY-LINE-BASE.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "INPUT_COUNT=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-ACCEPTED.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "ACCEPTED_COUNT=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-DUPLICATE.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "DUPLICATE_COUNT=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-REJECTED.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "REJECTED_COUNT=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-CLOSING.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "TOTAL_CLOSING_QTY=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-TRANSIT.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "OPEN_TRANSIT_QTY=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-ONHAND.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "ONHAND_VALUE_CENTS=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
WRITE-SUMMARY-TRANSIT-VALUE.
    MOVE SPACES TO WS-SUMMARY-LINE
    STRING "TRANSIT_VALUE_CENTS=" FUNCTION TRIM(WS-NUM-DISPLAY) DELIMITED BY SIZE INTO WS-SUMMARY-LINE END-STRING
    MOVE FUNCTION TRIM(WS-SUMMARY-LINE TRAILING) TO SUMMARY-RECORD
    WRITE SUMMARY-RECORD.
END PROGRAM DEPOT-TRANSFER-LEDGER.
