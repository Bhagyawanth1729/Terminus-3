#!/bin/sh
set -eu

if [ "$#" -ne 8 ] || [ "$1" != "--parts" ] || [ "$3" != "--stock" ] || [ "$5" != "--events" ] || [ "$7" != "--output" ]; then
    echo "usage: depot-ledger --parts FILE --stock FILE --events FILE --output DIR" >&2
    exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=$8
mkdir -p "$out"
for report in closing-stock.dat open-transit.dat exceptions.dat summary.dat; do
    rm -f "$out/$report"
done

exec "$root/build/depot-ledger-bin" "$@"
